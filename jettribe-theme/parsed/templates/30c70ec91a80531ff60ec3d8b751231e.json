{
  "pages/auth/login": "{{#partial \"page\"}}\n<div class=\"login\">\n    {{> components/common/breadcrumbs breadcrumbs=breadcrumbs}}\n    <h1 class=\"page-heading\">{{lang 'login.heading' }}</h1>\n    {{#if forms.login.error}}\n        {{> components/common/alert-error forms.login.error}}\n    {{/if}}\n    {{#if forms.login.success}}\n        {{> components/common/alert-success forms.login.success}}\n    {{/if}}\n    <div class=\"login-row\">\n        <form class=\"login-form form\" action=\"{{urls.auth.check_login}}\" method=\"post\">\n            {{inject 'useValidEmail' (lang 'forms.validate.common.email_address')}}\n            {{inject 'enterPass' (lang 'forms.validate.common.password')}}\n            <div class=\"form-field\">\n                <label class=\"form-label\" for=\"login_email\">{{lang 'login.field_email'}}</label>\n                <input class=\"form-input\" name=\"login_email\" id=\"login_email\" type=\"email\">\n            </div>\n            <div class=\"form-field\">\n                <label class=\"form-label\" for=\"login_pass\">{{lang 'login.field_password'}}</label>\n                <input class=\"form-input\" id=\"login_pass\" type=\"password\" name=\"login_pass\" autocomplete=\"off\">\n            </div>\n            <div class=\"form-actions\">\n                <input type=\"submit\" class=\"button button--primary\" value=\"{{lang 'login.submit_value' }}\">\n                <a class=\"forgot-password\" href=\"{{urls.auth.forgot_password}}\">{{lang 'login.forgot_password' }}</a>\n            </div>\n        </form>\n        {{#if settings.account_creation_enabled}}\n            <div class=\"new-customer\">\n                <div class=\"panel\">\n                    <div class=\"panel-header\">\n                        <h2 class=\"panel-title\">{{lang 'login.new_customer.heading' }}</h2>\n                    </div>\n                    <div class=\"panel-body\">\n                        <p class=\"new-customer-intro\">{{lang 'login.new_customer.intro' }}</p>\n                        <ul class=\"new-customer-fact-list\">\n                            <li class=\"new-customer-fact\">{{lang 'login.new_customer.fact1' }}</li>\n                            <li class=\"new-customer-fact\">{{lang 'login.new_customer.fact2' }}</li>\n                            <li class=\"new-customer-fact\">{{lang 'login.new_customer.fact3' }}</li>\n                            <li class=\"new-customer-fact\">{{lang 'login.new_customer.fact4' }}</li>\n                            <li class=\"new-customer-fact\">{{lang 'login.new_customer.fact5' }}</li>\n                        </ul>\n                        <a href=\"{{urls.auth.create_account}}\"><button class=\"button button--primary\">{{lang 'login.new_customer.create_account' }}</button></a>\n                    </div>\n                </div>\n            </div>\n        {{/if}}\n    </div>\n</div>\n{{/partial}}\n{{> layout/base}}\n",
  "components/common/breadcrumbs": "<ul class=\"breadcrumbs\" itemscope itemtype=\"http://schema.org/BreadcrumbList\">\n    {{#unless theme_settings.hide_breadcrumbs }}\n        {{#each breadcrumbs}}\n            <li class=\"breadcrumb {{#if @last}}is-active{{/if}}\" itemprop=\"itemListElement\" itemscope itemtype=\"http://schema.org/ListItem\">\n                {{#or @last (if url \"==\" null)}}\n                    <meta itemprop=\"item\" content=\"{{url}}\">\n                    <span class=\"breadcrumb-label\" itemprop=\"name\">{{name}}</span>\n                {{else}}\n                    <a href=\"{{url}}\" class=\"breadcrumb-label\" itemprop=\"item\"><span itemprop=\"name\">{{name}}</span></a>\n                {{/or}}\n                <meta itemprop=\"position\" content=\"{{add @index 1}}\" />\n            </li>\n        {{/each}}\n    {{/unless}}\n</ul>\n",
  "components/common/alert-error": "<div class=\"alertBox alertBox--error\">\n    <div class=\"alertBox-column alertBox-icon\">\n        <icon glyph=\"ic-error\" class=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"></path></svg></icon>\n    </div>\n    <p class=\"alertBox-column alertBox-message\">\n        <span>{{{this}}}</span>\n    </p>\n</div>\n",
  "components/common/alert-success": "<div class=\"alertBox alertBox--success\">\n    <div class=\"alertBox-column alertBox-icon\">\n        <icon glyph=\"ic-success\" class=\"icon\" aria-hidden=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"></path></svg></icon>\n    </div>\n    <p class=\"alertBox-column alertBox-message\">\n        <span>{{{this}}}</span>\n    </p>\n</div>\n",
  "layout/base": "<!DOCTYPE html>\r\n<html class=\"no-js\" lang=\"{{ locale_name }}\">\r\n    <head>\r\n        <title>{{ head.title }}</title>\r\n        <meta name=\"google-site-verification\" content=\"5Hartbp5gKkVrON7fHRBODeThLiAOm_GdrfVpWmLHx4\" />\r\n        {{{ resourceHints }}}\r\n        {{{ head.meta_tags }}}\r\n        {{{ head.config }}}\r\n        {{#block \"head\"}} {{/block}}\r\n\r\n        <link href=\"{{ head.favicon }}\" rel=\"shortcut icon\">\r\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1\">\r\n\t\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js\"></script>\r\n        <script>\r\n            {{!-- Change document class from no-js to js so we can detect this in css --}}\r\n            document.documentElement.className = document.documentElement.className.replace('no-js', 'js');\r\n        </script>\r\n        {{!-- Load Lazysizes script ASAP so images will appear --}}\r\n        <script>\r\n            {{!-- Only load visible elements until the onload event fires, after which preload nearby elements. --}}\r\n            window.lazySizesConfig = window.lazySizesConfig || {};\r\n            window.lazySizesConfig.loadMode = 1;\r\n        </script>\r\n        <script async src=\"{{cdn 'assets/dist/theme-bundle.head_async.js'}}\"></script>\r\n\r\n        {{ getFontsCollection }}\r\n        {{{stylesheet '/assets/css/theme.css'}}}\r\n\t\t<link href=\"{{cdn '/assets/scss/custom.css'}}\" rel=\"stylesheet\">\r\n        {{{head.scripts}}}\r\n\r\n        {{~inject 'themeSettings' theme_settings}}\r\n        {{~inject 'genericError' (lang 'common.generic_error')}}\r\n        {{~inject 'maintenanceMode' settings.maintenance}}\r\n        {{~inject 'urls' urls}}\r\n        {{~inject 'secureBaseUrl' settings.secure_base_url}}\r\n        {{~inject 'cartId' cart_id}}\r\n        {{~inject 'template' template}}\r\n        \r\n        <link href=\"https://trustspot.io/index.php/api/pub