# Database — local Postgres (default) or Supabase connection string
DATABASE_URL="postgresql://originality:originality@localhost:5432/originality?schema=public"

NEXT_PUBLIC_APP_NAME="Originality"
UPLOAD_DIR="./uploads"
REDIS_URL="redis://127.0.0.1:6379"

# Privacy: keep false on public demos so uploads are NEVER added to a shared corpus
ALLOW_REPOSITORY_INDEXING="false"

# Embeddings provider: openai | local
EMBEDDING_PROVIDER="local"
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# AI writing detection: local | openai
AI_DETECTION_PROVIDER="local"
OPENAI_AI_DETECT_MODEL="gpt-4o-mini"

# Optional Serper.dev key for live web matching
SERPER_API_KEY=""

DEMO_STUDENT_EMAIL="student@example.com"
DEMO_INSTRUCTOR_EMAIL="instructor@example.com"
