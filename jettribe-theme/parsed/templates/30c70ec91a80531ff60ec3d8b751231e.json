               </ul>\r\n            </article> -->\r\n\r\n            <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"storeInfo\">\r\n                <h5 class=\"footer-info-heading\">Contact Us</h5>\r\n                <div class=\"contactInfo\">\r\n                \t<p class=\"ftrlocationIc\"><strong>Jettribe Corporate California</strong><br />(No Products at this Location)<br />Temecula, California<br />Office By Appointment Only</p>\r\n                \t<p class=\"ftrlocationIc\"><strong>Jettribe Shipping Distribution</strong> <br />1120 Como Street South<br />Sulphur Springs, Texas 75482 <br />\r\n                    <p class=\"ftrcallIc\"><strong>Contact Jettribe Rider Support</strong> <br /><a href=\"tel:951.246.3147\" title=\"951.246.3147\">951.246.3147</a> <br />Mon - Fri, 9am - 4pm PST</p>\r\n                    <p class=\"ftrmailIc\"><a href=\"mailto:ridersupport@jettribe.com\" title=\"ridersupport@jettribe.com\">ridersupport@jettribe.com</a></p>\r\n                </div>\r\n                \r\n            </article>\r\n\r\n            <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"newsletterSubscription\">\r\n                <div class=\"ftrNewsletter\">\r\n                    {{#if settings.show_newsletter_box}}\r\n                        {{> components/common/subscription-form}}\r\n                    {{/if}}\r\n                </div>\r\n            </article>\r\n        </section>\r\n        \r\n        <div class=\"footerSocial\">\r\n        \t{{> components/common/social-links}}\r\n        </div>\r\n        \r\n        <div class=\"footerLogo\">\r\n        \t<a href=\"/\"><img src=\"{{cdn '/assets/img/footer-logo.png'}}\" alt=\"\" /></a>\r\n        </div>\r\n        \r\n    </div>\r\n    </div>\r\n    <div class=\"footerBottom\">\r\n    \t<div class=\"container\">\r\n        <div class=\"paymentIc\">\r\n        \t<img src=\"{{cdn '/assets/img/payment-ic.png'}}\" alt=\"\" />\r\n        </div>\r\n        \t{{#if theme_settings.show_copyright_footer}}\r\n                <div class=\"footer-copyright\">\r\n                    <p class=\"powered-by\">&copy; {{moment format=\"YYYY\"}} <strong>Jet Tribe</strong>, All rights Reserved. <span class=\"bull\">&bull;</span> <br /><a href=\"https://www.qeretail.com/services/ecommerce-website-development\" target=\"_blank\">Custom eCommerce website design</a> - <strong>QeRetail</strong> </p>\r\n                </div>\r\n            {{/if}}\r\n        </div>\r\n    </div>\r\n    <style>.productOptions-list-item-figure {\r\n    width: 100px;\r\n}</style>\r\n\r\n<style>\r\n.videoGallery-main { \r\npadding-bottom: 50%; \r\n}\r\n\r\n.footer-info-list .footer-customization-form {\r\n    display: inline-block;\r\n    margin-top: 10px;\r\n    min-width: 0;\r\n    height: auto;\r\n    padding: 8px 14px;\r\n    font-size: 12px;\r\n    line-height: 1.2;\r\n    letter-spacing: 0.5px;\r\n    color: #fff !important;\r\n    text-decoration: none;\r\n}\r\n.footer-info-list .footer-customization-form:hover,\r\n.footer-info-list .footer-customization-form:focus {\r\n    color: #fff !important;\r\n}\r\n</style>\r\n\r\n</footer>\r\n",
  "components/common/navigation": "<nav class=\"navUser\">\r\n    <!-- {{> components/common/currency-selector}} -->\r\n\r\n    <ul class=\"navUser-section navUser-section--alt\">\r\n        <li class=\"navUser-item\">\r\n            <div id=\"google_translate_element\"></div>\r\n            <script type=\"text/javascript\">\r\n                function googleTranslateElementInit() {\r\n                    new google.translate.TranslateElement({pageLanguage: 'en'}, 'google_translate_element');\r\n                }\r\n            </script>\r\n            <script type=\"text/javascript\" src=\"//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit\"></script>\r\n        </li>\r\n        {{#if customer.store_credit.value '>' 0}}\r\n            <li class=\"navUser-item\">\r\n                <a class=\"navUser-action navUser-action--storeCredit\"\r\n                   data-dropdown=\"storeCredit-dropdown\"\r\n                   data-options=\"align:bottom\"\r\n                   href=\"{{urls.cart}}\">\r\n                        <span class=\"navUser-action-divider\">{{lang 'common.store_credit_overview' credit=customer.store_credit.formatted}}</span>\r\n                </a>\r\n                <div class=\"dropdown-menu\" id=\"storeCredit-dropdown\" data-dropdown-content aria-hidden=\"true\">\r\n                    {{{lang 'common.store_credit' store_credit=customer.store_credit.formatted}}}\r\n                </div>\r\n            </li>\r\n        {{/if}}\r\n        <li class=\"navUser-item\">\r\n            <a class=\"navUser-action navUser-item--compare\" href=\"{{urls.compare}}\" data-compare-nav>{{lang 'common.compare'}} <span class=\"countPill countPill--positive countPill--alt\"></span></a>\r\n        </li>\r\n        {{#if theme_settings.social_icon_placement_top}}\r\n            <li class=\"navUser-item navUser-item--social\">\r\n                {{> components/common/social-links}}\r\n            </li>\r\n            <li class=\"navUser-item 