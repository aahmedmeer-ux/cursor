# n8n webhook endpoint that receives search keywords and returns enriched leads
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/lead-hunt

# Seconds to wait for the n8n webhook before timing out
N8N_TIMEOUT_SECONDS=60

# When true (or when the webhook is unreachable), return mock leads after a short delay
USE_MOCK_LEADS=true

# Comma-separated origins allowed by CORS (frontend URL)
CORS_ORIGINS=http://localhost:3000

# FastAPI host/port (used by uvicorn when started via python -m)
HOST=0.0.0.0
PORT=8000
