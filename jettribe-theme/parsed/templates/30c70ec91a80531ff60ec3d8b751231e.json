\n</html>\r\n",
  "components/common/header": "<header class=\"header\" role=\"banner\">\r\n\t<script>\r\n\t  $(document).ready(function(){\r\n\t\t  $('body').on('click', 'a.modal-close',  function() {\r\n\t\t\t\t\t$(\".quickSearchResults\").html(\"\");\r\n\t\t  });\t\r\n\t  });\r\n\t</script>\r\n    \r\n    \r\n    <div class=\"headerTop\">\r\n    \t<div class=\"container\">\r\n    \t<p><strong>Free USA Shipping on Orders $250+</strong></p>\r\n        </div>\r\n    </div>\r\n    <div class=\"headerBottom\">\r\n    \t<div class=\"container\">\r\n            <a href=\"#\" class=\"mobileMenu-toggle\" data-mobile-menu-toggle=\"menu\">\r\n                <span class=\"mobileMenu-toggleIcon\">Toggle menu</span>\r\n            </a>\r\n            <div class=\"headerLeft\">\r\n            \t<div class=\"header-logo header-logo--{{theme_settings.logo-position}}\">\r\n                    {{> components/common/store-logo}}\r\n                </div>\r\n            </div>\r\n            <div class=\"headerRight\">\r\n            \t<div class=\"hdrrightTop\">\r\n            \t\t{{> components/common/navigation}}\r\n                </div>\r\n                <div class=\"hdrrightBtm\">\r\n                \t<div class=\"callIc\"><a href=\"tel:951 246 3147\" title=\"951 246 3147\">951 246 3147</a></div>\r\n                    <div class=\"hdrSearch\">\r\n                    \t<div class=\"dropdown dropdown--quickSearch\" id=\"quickSearch\" aria-hidden=\"true\" tabindex=\"-1\" data-prevent-quick-search-close>\r\n                            {{> components/common/quick-search}}\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n    \t</div>\r\n    </div>\r\n\r\n    \r\n    \r\n    <div class=\"navPages-container\" id=\"menu\" data-menu>\r\n        {{> components/common/navigation-menu}}\r\n    </div>\r\n</header>\r\n{{{region name=\"header_bottom\"}}}\r\n",
  "components/common/cookie": "<div class=\"cookieMessage\">\n    <div class=\"cookieMessage-container\">\n        <div class=\"cookieMessage-text\">\n            <p>{{settings.privacy_cookie}}</p>\n        </div>\n        <button class=\"button button--primary button--small\" data-privacy-accept>{{lang 'cookies.accept'}}</button>\n    </div>\n</div>\n",
  "components/common/body": "<div class=\"body\" data-currency-code=\"{{currency_selector.active_currency_code}}\">\r\n    {{#block \"hero\"}} {{/block}}\r\n    \r\n    <div class=\"container\">\r\n    \t\r\n         \r\n        {{#block \"page\"}} {{/block}}\r\n        \r\n          \r\n    </div>\r\n    \r\n    {{> components/common/modal}}\r\n    {{> components/common/alert-modal}}\r\n</div>\r\n",
  "components/common/footer": "<footer class=\"footer\" role=\"contentinfo\">\r\n    <div class=\"footerTop\">\r\n    \t<div class=\"container\">\r\n        {{#if theme_settings.social_icon_placement_bottom '!==' 'bottom_none'}}\r\n            <article class=\"footer-info-col\r\n                footer-info-col--social\r\n                footer-info-col--{{#if theme_settings.social_icon_placement_bottom '===' 'bottom_left'}}left{{else}}right{{/if}}\"\r\n                data-section-type=\"footer-webPages\">\r\n                    <h5 class=\"footer-info-heading\">{{lang 'social.connect'}}</h5>\r\n                    {{> components/common/social-links}}\r\n            </article>\r\n        {{/if}}\r\n        <section class=\"footer-info\">\r\n            <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"footer-categories\">\r\n                <h5 class=\"footer-info-heading\">{{lang 'footer.categories'}}</h5>\r\n                <ul class=\"footer-info-list\">\r\n                    {{#each categories}}\r\n                        <li>\r\n                            <a href=\"{{url}}\">{{name}}</a>\r\n                        </li>\r\n                    {{/each}}\r\n                </ul>\r\n            </article>\r\n            \r\n            <article class=\"footer-info-col footer-info-col--small\" data-section-type=\"footer-webPages\">\r\n                <h5 class=\"footer-info-heading\">Rider Support</h5>\r\n                <ul class=\"footer-info-list\">\r\n                    <li><a href=\"#\">Order Status</a></li>\r\n                    <li><a href=\"/shipping-info/\">Shipping Info</a></li>\r\n                    <li><a href=\"/return-policy/\">Return Policy</a></li>\r\n                    <li><a href=\"/warranty-policy/\">Warranty Policy</a></li>\r\n                    <li><a href=\"/financing/\">Financing</a></li>\r\n                    <li><a href=\"/privacy-policy/\">Privacy Policy</a></li>\r\n                    <li>\r\n          